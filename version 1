local function GetPlayerNames()
   local names = {}
   for _, plr in pairs(Players:GetPlayers()) do
      if plr ~= LocalPlayer then
         table.insert(names, plr.Name)
      end
   end
   if #names == 0 then
      names = {"No players found"}
   end
   return names
end

local function CopyAvatar(targetName)
   local targetPlayer = Players:FindFirstChild(targetName)
   if not targetPlayer then
      Rayfield:Notify({Title = "SavenHub", Content = "Player not found", Duration = 4})
      return
   end

   local myChar = LocalPlayer.Character
   local targetChar = targetPlayer.Character
   if not myChar or not targetChar then
      Rayfield:Notify({Title = "SavenHub", Content = "Character not loaded", Duration = 4})
      return
   end

   local myHum = myChar:FindFirstChildOfClass("Humanoid")
   local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
   if not myHum or not targetHum then return end

   -- Method 1: Web API Description
   local success, desc = pcall(function()
      return Players:GetHumanoidDescriptionFromUserId(targetPlayer.UserId)
   end)

   if success and desc then
      pcall(function() myHum:ApplyDescription(desc) end)
      Rayfield:Notify({Title = "SavenHub", Content = "Copied avatar description from " .. targetName, Duration = 4})
      return
   end

   -- Method 2: Physical Asset Cloning (For Brookhaven & Live Together)
   for _, v in pairs(myChar:GetChildren()) do
      if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") or v:IsA("ShirtGraphic") then
         v:Destroy()
      end
   end

   for _, v in pairs(targetChar:GetChildren()) do
      if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") or v:IsA("ShirtGraphic") then
         v:Clone().Parent = myChar
      end
   end

   Rayfield:Notify({Title = "SavenHub", Content = "Cloned character physical assets from " .. targetName, Duration = 4})
end

