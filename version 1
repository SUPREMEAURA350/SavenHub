local antiFlingEnabled = false
local antiFallDamageEnabled = false
local antiSitEnabled = false
local MAX_SAFE_VELOCITY = 100
local lastHealth = 100

RunService.Heartbeat:Connect(function()
   if not (antiFlingEnabled or antiFallDamageEnabled or antiSitEnabled) then return end
   local char = LocalPlayer.Character
   if not char then return end
   local hrp = char:FindFirstChild("HumanoidRootPart")
   local hum = char:FindFirstChild("Humanoid")

   if antiFlingEnabled and hrp then
      if hrp.Velocity.Magnitude > MAX_SAFE_VELOCITY then
         hrp.Velocity = hrp.Velocity.Unit * MAX_SAFE_VELOCITY
      end
      if hrp.RotVelocity.Magnitude > 50 then
         hrp.RotVelocity = Vector3.new(0, 0, 0)
      end
   end

   if antiFallDamageEnabled and hum then
      if hum.Health < lastHealth and hum:GetState() == Enum.HumanoidStateType.Landed then
         hum.Health = lastHealth
      end
      lastHealth = hum.Health
   end

   if antiSitEnabled and hum then
      if hum.Sit then
         hum.Sit = false
         hum:ChangeState(Enum.HumanoidStateType.GettingUp)
      end
   end
end)

