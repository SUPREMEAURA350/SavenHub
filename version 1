Intro Screen Overlay 
local function playIntroScreen()
    local sg = Instance.new("ScreenGui")
    sg.Name = "SavenHub🔥"
    sg.ResetOnSpawn = false
    sg.Parent = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")

    -- Main Card Container
    local card = Instance.new("Frame")
    card.Size = UDim2.new(0, 420, 0, 240)
    card.Position = UDim2.new(0.5, -210, 0.5, -120)
    card.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    card.BackgroundTransparency = 0.25
    card.BorderSizePixel = 0
    card.Parent = sg

    local cardCorner = Instance.new("UICorner")
    cardCorner.CornerRadius = UDim.new(0, 30)
    cardCorner.Parent = card

    -- Outer Purple Glow Ring
    local outerGlow = Instance.new("UIStroke")
    outerGlow.Color = Color3.fromRGB(160, 32, 240)
    outerGlow.Thickness = 6
    outerGlow.Transparency = 0.3
    outerGlow.Parent = card

    -- Inner Purple Border
    local innerBorder = Instance.new("UIStroke")
    innerBorder.Color = Color3.fromRGB(200, 50, 255)
    innerBorder.Thickness = 2
    innerBorder.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    innerBorder.Parent = card

    -- Avatar Headshot Image
    local avatarFrame = Instance.new("Frame")
    avatarFrame.Size = UDim2.new(0, 80, 0, 80)
    avatarFrame.Position = UDim2.new(0.5, -40, 0.1, 0)
    avatarFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    avatarFrame.Parent = card

    local avatarCorner = Instance.new("UICorner")
    avatarCorner.CornerRadius = UDim.new(1, 0)
    avatarCorner.Parent = avatarFrame

    local avatarStroke = Instance.new("UIStroke")
    avatarStroke.Color = Color3.fromRGB(180, 50, 255)
    avatarStroke.Thickness = 3
    avatarStroke.Parent = avatarFrame

    local avatarImg = Instance.new("ImageLabel")
    avatarImg.Size = UDim2.new(1, 0, 1, 0)
    avatarImg.BackgroundTransparency = 1
    avatarImg.Image = Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
    avatarImg.Parent = avatarFrame

    local imgCorner = Instance.new("UICorner")
    imgCorner.CornerRadius = UDim.new(1, 0)
    imgCorner.Parent = avatarImg

    -- Main Title Text
    local titleText = Instance.new("TextLabel")
    titleText.Size = UDim2.new(1, 0, 0, 30)
    titleText.Position = UDim2.new(0, 0, 0.5, 0)
    titleText.BackgroundTransparency = 1
    titleText.Text = "SavenHub🔥"
    titleText.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleText.TextSize = 22
    titleText.Font = Enum.Font.GothamBold
    titleText.Parent = card

    -- Subtitle Loading / Welcome Text
    local statusText = Instance.new("TextLabel")
    statusText.Size = UDim2.new(1, 0, 0, 25)
    statusText.Position = UDim2.new(0, 0, 0.72, 0)
    statusText.BackgroundTransparency = 1
    statusText.Text = "AUTHENTICATING SavenHub..."
    statusText.TextColor3 = Color3.fromRGB(180, 50, 255)
    statusText.TextSize = 14
    statusText.Font = Enum.Font.Code
    statusText.Parent = card

    -- Animation sequence
    task.wait(1.5)
    statusText.Text = "WELCOME, " .. string.upper(LocalPlayer.Name) .. "To SavenHub 🔥"
    statusText.TextColor3 = Color3.fromRGB(255, 0, 255)
    task.wait(1.5)

    -- Fade out
    local fade = TweenService:Create(card, TweenInfo.new(0.6), {BackgroundTransparency = 1})
    TweenService:Create(titleText, TweenInfo.new(0.6), {TextTransparency = 1}):Play()
    TweenService:Create(statusText, TweenInfo.new(0.6), {TextTransparency = 1}):Play()
    TweenService:Create(avatarImg, TweenInfo.new(0.6), {ImageTransparency = 1}):Play()
    TweenService:Create(outerGlow, TweenInfo.new(0.6), {Transparency = 1}):Play()
    TweenService:Create(innerBorder, TweenInfo.new(0.6), {Transparency = 1}):Play()
    TweenService:Create(avatarStroke, TweenInfo.new(0.6), {Transparency = 1}):Play()
    fade:Play()
    fade.Completed:Wait()
    sg:Destroy()
end

-- Run Intro First
playIntroScreen()
